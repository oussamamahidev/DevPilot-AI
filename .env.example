APP_NAME=DevPilot AI
APP_ENV=development
SECRET_KEY=change-me-in-production-use-a-real-32-char-secret

POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot
POSTGRES_DB=devpilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://devpilot:devpilot@postgres:5432/devpilot

REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6380
QDRANT_URL=http://qdrant:6333
QDRANT_HOST_PORT=6335
QDRANT_GRPC_HOST_PORT=6336

LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_GENERATION_MODEL=qwen2.5:3b-instruct-q3_K_S
OLLAMA_CHAT_THINK=false
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=120
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BACKOFF_SECONDS=2
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=4
GENERATION_TEMPERATURE=0.2
GENERATION_MAX_TOKENS=1000
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000
ENABLE_RERANKING=true
ENABLE_OLLAMA_RERANKER=false
RETRIEVAL_CANDIDATES=15
RERANK_TOP_K=5
MAX_UPLOAD_SIZE=10485760

# Optional future OpenAI support. Not required for local Ollama-first development.
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=
OPENAI_EMBEDDING_MODEL=

FRONTEND_URL=http://localhost:3000
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
